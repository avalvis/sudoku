{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Editorial Sudoku",
  "version": "0.1.0",
  "identifier": "dev.editorial.sudoku",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Editorial — Sudoku", "width": 1280, "height": 900, "minWidth": 900, "minHeight": 700, "center": true, "resizable": true, "backgroundColor": "#F9F6F0" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "A quiet place for a good puzzle.",
    "category": "PuzzleGame",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false, "compression": "zlib" },
      "wix": { "language": "en-US" }
    }
  }
}
